msgstr "მეთოდები"

#: includes/Admin/Dashboard.php:17
msgid "Simulator"
msgstr "ტარიფის სიმულაცია"

#: includes/Admin/Dashboard.php:18
msgid "Tools"
msgstr "ხელსაწყოები"

