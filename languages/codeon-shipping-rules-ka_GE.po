msgstr "ველის „%s“ მნიშვნელობა უარყოფითი ვერ იქნება."

#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:48
#, php-format
msgid "Enter a value greater than zero in “%s”."
msgstr "ველში „%s“ შეიყვანეთ ნულზე მეტი მნიშვნელობა."

#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:50
#, php-format
