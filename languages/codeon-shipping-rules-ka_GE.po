#: includes/Import/Importer.php:108
msgid "CSV imports can contain up to 1,000 rows."
msgstr "CSV ფაილი მაქსიმუმ 1 000 სტრიქონს შეიძლება შეიცავდეს."

#. translators: %d: CSV line number.
#: includes/Import/Importer.php:115
#, php-format
msgid "CSV row %d has the wrong number of columns."
msgstr "CSV ფაილის მე-%d სტრიქონში სვეტების რაოდენობა არასწორია."

#: includes/Import/Importer.php:135
msgid "Every CSV row needs a method title."
msgstr "CSV ფაილის ყველა სტრიქონში მიუთითეთ მეთოდის სახელი."

#: includes/Import/Importer.php:163
msgid "Every Flexible Shipping CSV row needs a method title."
msgstr "Flexible Shipping-ის CSV ფაილის ყველა სტრიქონში მიუთითეთ მეთოდის სახელი."

#: includes/Import/TierCsv.php:14
msgid "Add at least one pricing tier before exporting to CSV."
msgstr "CSV ფაილის ექსპორტამდე დაამატეთ სულ მცირე ერთი სატარიფო დიაპაზონი."

#: includes/Import/TierCsv.php:23
msgid "This method uses complex rules. Export JSON to keep every condition and charge."
msgstr "ეს მეთოდი რთულ წესებს იყენებს. ყველა პირობისა და საფასურის შესანარჩუნებლად გამოიყენეთ JSON ექსპორტი."

#: includes/Import/TierCsv.php:28
msgid "Export JSON to preserve condition values that contain a vertical bar."
msgstr "გამოიყენეთ JSON ექსპორტი, რომ შეინარჩუნოთ პირობის მნიშვნელობები, რომლებიც ვერტიკალურ ხაზს შეიცავს."

#: includes/Plugin.php:51 includes/Plugin.php:53
msgid "Shipping Rules"
msgstr "მიწოდების წესები"

#. translators: 1: the rule number, 2: a validation message.
#: includes/Rules/ValidationMessages.php:14
#, php-format
msgid "Rule %1$d — %2$s"
msgstr "წესი %1$d — %2$s"

#: includes/Rules/ValidationMessages.php:22
msgid "Minimum cost cannot exceed maximum cost."
msgstr "მინიმალური საფასური მაქსიმალურ საფასურს ვერ გადააჭარბებს."

#: includes/Rules/ValidationMessages.php:23
msgid "Duplicate rule ID."
msgstr "წესის იდენტიფიკატორი მეორდება."

#: includes/Rules/ValidationMessages.php:25
msgid "Rule ID may contain only letters, numbers, underscores and hyphens."
msgstr "წესის იდენტიფიკატორი შეიძლება შეიცავდეს მხოლოდ ლათინურ ასოებს, ციფრებს, ქვედა ტირეებსა და დეფისებს."

#: includes/Rules/ValidationMessages.php:27
msgid "Use a public product field key that starts with a letter."
msgstr "გამოიყენეთ პროდუქტის საჯარო ველის გასაღები, რომელიც ლათინური ასოთი იწყება."

#: includes/Rules/ValidationMessages.php:28
msgid "Select at least one condition value."
msgstr "პირობისთვის აირჩიეთ სულ მცირე ერთი მნიშვნელობა."

#: includes/Rules/ValidationMessages.php:29
msgid "Days of week must use numbers 1 through 7."
msgstr "კვირის დღეებისთვის გამოიყენეთ რიცხვები 1-დან 7-მდე."

#: includes/Rules/ValidationMessages.php:30
msgid "The condition range is empty."
msgstr "პირობის დიაპაზონს არცერთი მნიშვნელობა არ შეესაბამება."

#: includes/Rules/ValidationMessages.php:32
msgid "Shipping calculation exceeds the supported numeric range."
msgstr "მიწოდების საფასურის დათვლისას მიღებული რიცხვი დასაშვებ დიაპაზონს სცდება."

#. translators: %s: a configured condition type.
#: includes/Rules/ValidationMessages.php:40
#, php-format
msgid "Unknown condition type “%s”."
