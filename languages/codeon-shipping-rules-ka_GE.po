#: includes/Admin/Api.php:53
msgid "The request is too large."
msgstr "მოთხოვნა მეტისმეტად დიდია."

#: includes/Admin/Api.php:65
msgid "The request could not be completed. Try again."
msgstr "მოთხოვნა ვერ შესრულდა. სცადეთ ხელახლა."

#: includes/Admin/Api.php:114
msgid "Enter a delivery method name."
msgstr "შეიყვანეთ მიწოდების მეთოდის სახელი."

#: includes/Admin/Api.php:144
msgid "Change the live service status in WooCommerce Shipping Zones."
msgstr "მოქმედი სერვისის სტატუსი WooCommerce-ის მიწოდების ზონებში შეცვალეთ."

#: includes/Admin/Api.php:147
msgid "Choose whether to enable this method."
msgstr "აირჩიეთ, გსურთ თუ არა ამ მეთოდის ჩართვა."

#: includes/Admin/Api.php:150
msgid "Publish rules before enabling this method."
msgstr "ამ მეთოდის ჩართვამდე გამოაქვეყნეთ მისი წესები."

#: includes/Admin/Api.php:161
msgid "Use an export to copy adjustments to another service."
msgstr "საფასურის ცვლილებები სხვა სერვისში ექსპორტით გადაიტანეთ."

#. translators: %s: name of the method being duplicated.
#: includes/Admin/Api.php:169
#, php-format
msgid "%s (copy)"
msgstr "%s (ასლი)"

#: includes/Admin/Api.php:208
msgid "One of the selected products is unavailable."
msgstr "ერთ-ერთი შერჩეული პროდუქტი მიუწვდომელია."

#: includes/Admin/Api.php:265
msgid "Use a valid local time in hours and minutes."
msgstr "შეიყვანეთ სწორი ადგილობრივი დრო საათებითა და წუთებით."

#: includes/Admin/Api.php:274
msgid "Choose a valid WooCommerce currency."
msgstr "აირჩიეთ WooCommerce-ის მხარდაჭერილი ვალუტა."

#: includes/Admin/Api.php:297
msgid "A rule follows an unconditional stop or hide and cannot be reached."
msgstr "უპირობო შეწყვეტის ან დამალვის წესის შემდეგ სხვა წესია, რომელიც ვერ შესრულდება."

#: includes/Admin/Api.php:305
msgid "Two pricing bands overlap. Review the combined price at their shared boundary."
msgstr "ორი სატარიფო დიაპაზონი ერთმანეთს კვეთს. მათ გადაკვეთაზე გადაამოწმეთ საბოლოო საფასური."

#: includes/Admin/Api.php:306
msgid "Two pricing bands leave a gap where this method can disappear."
msgstr "ორ სატარიფო დიაპაზონს შორის შუალედში ეს მეთოდი შეიძლება აღარ გამოჩნდეს."

#: includes/Admin/Api.php:307
msgid "One pricing band has no matching values at the store’s precision."
msgstr "მაღაზიის სიზუსტით დამრგვალებისას ერთ-ერთ სატარიფო დიაპაზონს არცერთი მნიშვნელობა არ შეესაბამება."

#: includes/Admin/Api.php:308
msgid "The free-shipping threshold falls outside the eligible rate bands."
msgstr "უფასო მიწოდების ზღვარი არცერთი შესაბამისი სატარიფო დიაპაზონის ფარგლებში არ ხვდება."

#: includes/Admin/Api.php:309
msgid "Review the rate bands and their boundaries."
msgstr "გადაამოწმეთ სატარიფო დიაპაზონები და მათი ზღვრები."

#: includes/Admin/Api.php:313
msgid "This example has no rate for this method. Check the rules or add an intentional fallback."
msgstr "ამ მაგალითში მეთოდს ტარიფი არ აქვს. გადაამოწმეთ წესები ან მიუთითეთ სათადარიგო საფასური."

#: includes/Admin/Api.php:323
msgid "Upload or paste a rules file."
msgstr "ატვირთეთ წესების ფაილი ან ჩასვით მისი შემცველობა."

#: includes/Admin/Api.php:329
msgid "Resolve the import issues before creating drafts."
msgstr "მონახაზების შექმნამდე გამოასწორეთ იმპორტის ხარვეზები."

#: includes/Admin/Api.php:334
msgid "Choose a single-method file to load into an existing draft."
msgstr "არსებულ მონახაზში ჩასატვირთად აირჩიეთ ფაილი, რომელიც ერთ მეთოდს შეიცავს."

#: includes/Admin/Api.php:353
msgid "Another import is running in this zone. Try again shortly."
msgstr "ამ ზონაში სხვა იმპორტი მიმდინარეობს. ცოტა ხანში სცადეთ ხელახლა."

#: includes/Admin/Api.php:451
msgid "A rules configuration is required."
msgstr "მიუთითეთ წესების პარამეტრები."

#: includes/Admin/Api.php:499
msgid "That shipping method is unavailable."
msgstr "მიწოდების ეს მეთოდი მიუწვდომელია."

#: includes/Admin/Api.php:511
msgid "That shipping zone is unavailable."
msgstr "მიწოდების ეს ზონა მიუწვდომელია."

#: includes/Admin/Api.php:524
msgid "Enter valid scenario quantities and amounts."
msgstr "შეიყვანეთ სცენარის სწორი რაოდენობები და თანხები."

#: includes/Admin/Dashboard.php:16
