#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:44
#, php-format
msgid "Enter a decimal number in “%s”."
msgstr "ველში „%s“ შეიყვანეთ ათწილადი რიცხვი."

#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:46
#, php-format
