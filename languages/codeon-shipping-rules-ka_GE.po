#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:60
#, php-format
msgid "Check the fields in “%s”."
msgstr "გადაამოწმეთ ველები განყოფილებაში „%s“."

#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:75
#, php-format
