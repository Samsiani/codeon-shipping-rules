#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:54
#, php-format
msgid "Shorten the value in “%s”."
msgstr "შეამოკლეთ ველში „%s“ შეყვანილი მნიშვნელობა."

#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:56
#, php-format
msgid "Enter a whole number equal to or greater than zero in “%s”."
msgstr "ველში „%s“ შეიყვანეთ ნული ან დადებითი მთელი რიცხვი."

#. translators: %s: a field name.
#: includes/Rules/ValidationMessages.php:58
#, php-format
